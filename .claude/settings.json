{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "cd /home/user/yao && npm run qc --silent 2>&1 | tail -20; exit ${PIPESTATUS[0]}",
            "timeout": 120,
            "statusMessage": "Running QC checks before commit..."
          }
        ]
      }
    ]
  }
}
