# ---- 模型 API ----
# Claude 為「選用」：留空即為免費單模型模式（只用下面的本機 Ollama，零 token 成本）。
# 填了才會啟用雙模型交叉驗證（品質較高，但會用 Claude 額度＝花錢）。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ---- AI 工房（第二個逆向模型）----
# 這裡用 Mac Studio 上本機的 Ollama（程式跟 Ollama 在同一台，所以走 localhost）。
AI_WORKSHOP_BASE_URL=http://localhost:11434/v1
AI_WORKSHOP_API_KEY=ollama
# 必須是「看得懂圖」的模型。先在終端機跑：ollama pull qwen2.5vl:7b
AI_WORKSHOP_MODEL=qwen2.5vl:7b

# ---- Notion ----
# 在 https://www.notion.so/my-integrations 建立 internal integration，
# 並把該 integration 加入「圖像分析資料庫」的連線權限。
NOTION_API_KEY=secret_...
# 圖像分析資料庫的 data source (collection) id
NOTION_DATABASE_ID=e771e46f-f611-405c-8651-432aae03ba11

# ---- 驗證門檻 ----
# 最終信心分數 >= 此值才寫入 Notion (0~1)
CONFIDENCE_THRESHOLD=0.75

# ---- Pinterest 抓取 ----
# 私人看板需登入：用 Playwright 存好的 storage_state JSON 路徑（選填，公開看板可留空）
PINTEREST_STORAGE_STATE=
# 每個來源最多抓幾張
MAX_PINS=30
# 捲動次數（越多載入越多 pin）
SCROLL_ROUNDS=8
