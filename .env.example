# Copy to .env and adjust. The .env file is gitignored.

# HTTP server
PORT=4711
HOST=0.0.0.0
# DB file path (relative to repo root or absolute)
DB_PATH=./data/ethereal.db

# Access token required for any non-localhost request (phone / Tailscale).
# Generate a long random string, e.g. `openssl rand -hex 32`.
AUTH_TOKEN=change-me-to-a-long-random-string

# Local LLM (Ollama) running on the Mac Studio — free, unlimited, private.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# Set to 0 to disable LLM whispers entirely (template fallback still works).
WHISPER_ENABLED=1
