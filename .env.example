# 把這個檔案複製成 .env 後填入你的值：  cp .env.example .env

# 你的 Threads 使用者 ID（數字）。取得方式見 README。
THREADS_USER_ID=

# Threads API 的長期存取權杖（long-lived access token，約 60 天有效）
THREADS_ACCESS_TOKEN=

# 每天要發文的時間，24 小時制、用逗號分隔。預設兩個時間 = 每天兩篇。
SCHEDULE_TIMES=08:00,22:00

# 時區（IANA 格式）。台灣請用 Asia/Taipei。
TIMEZONE=Asia/Taipei

# 用 AI 自動把素材生成貼文時需要（yao generate）。
# 到 https://console.anthropic.com 取得 API key。
ANTHROPIC_API_KEY=
