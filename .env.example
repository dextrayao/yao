# ---- 模型 API ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# ---- AI 工房（第二個逆向模型，OpenAI 相容、支援看圖）----
# Mac Studio 上的本機模型伺服器，經 Tailscale 對外。
AI_WORKSHOP_BASE_URL=https://macmac-studio.tailbfceaf.ts.net/v1
AI_WORKSHOP_API_KEY=local
# 看得懂圖的模型名；不確定就跑 deploy/detect_workshop.py 列出來
AI_WORKSHOP_MODEL=

# ---- Notion ----
# 在 https://www.notion.so/my-integrations 建立 internal integration，
# 並把該 integration 加入「圖像分析資料庫」的連線權限。
NOTION_API_KEY=secret_...
# 圖像分析資料庫的 data source (collection) id
NOTION_DATABASE_ID=e771e46f-f611-405c-8651-432aae03ba11

# ---- 驗證門檻 ----
# 最終信心分數 >= 此值才寫入 Notion (0~1)
CONFIDENCE_THRESHOLD=0.75

# ---- Pinterest 抓取 ----
# 私人看板需登入：用 Playwright 存好的 storage_state JSON 路徑（選填，公開看板可留空）
PINTEREST_STORAGE_STATE=
# 每個來源最多抓幾張
MAX_PINS=30
# 捲動次數（越多載入越多 pin）
SCROLL_ROUNDS=8
