    "generate": "node bin/yao.js generate",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  }
