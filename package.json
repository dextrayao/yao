{
  "name": "yao",
  "version": "1.0.0",
  "description": "依照預先寫好的內容，每天定時自動發兩篇貼文到 Threads",
  "type": "commonjs",
  "bin": {
    "yao": "bin/yao.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "publish-now": "node bin/yao.js publish-now",
