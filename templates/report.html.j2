<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.iso_week }} ・ 酷客創藝 專案人力成本週報</title>
<style>{{ css }}</style>
</head>
<body>
<div class="container">

  <header class="hero">
    <p class="eyebrow">酷客創藝 ・ Weekly Labor Cost Report</p>
    <h1>第 {{ week_number }} 週 ・ 專案人力成本</h1>
    <p class="meta">
      <span>📅 {{ report.week_start.strftime('%Y/%m/%d') }} – {{ report.week_end.strftime('%Y/%m/%d') }}</span>
      <span>🧾 {{ report.iso_week }}</span>
      <span>⏱ 產生於 {{ generated_at }}</span>
    </p>
  </header>

  <section>
    <div class="kpi-grid">
      <div class="kpi">
        <div class="label">本週總成本</div>
        <div class="value">NT$ {{ '{:,.0f}'.format(report.total_cost) }}</div>
        <div class="sub">{{ '{:,.1f}'.format(report.total_hours) }} 小時 ・ 完整勞動成本 ×1.2551</div>
      </div>
      <div class="kpi">
        <div class="label">計費客戶成本</div>
        <div class="value">NT$ {{ '{:,.0f}'.format(report.billable_cost) }}</div>
        <div class="sub">{{ '{:,.1f}'.format(report.billable_hours) }} 小時 ・ {{ '{:.0%}'.format(report.billable_cost / report.total_cost if report.total_cost else 0) }} 占比</div>
      </div>
      <div class="kpi">
        <div class="label">內部投入</div>
        <div class="value">NT$ {{ '{:,.0f}'.format(report.internal_cost) }}</div>
        <div class="sub">{{ '{:,.1f}'.format(report.internal_hours) }} 小時 ・ 自媒體/管理/學習</div>
      </div>
      <div class="kpi">
        <div class="label">請假成本</div>
        <div class="value">NT$ {{ '{:,.0f}'.format(report.leave_cost) }}</div>
        <div class="sub">{{ '{:,.1f}'.format(report.leave_hours) }} 小時</div>
      </div>
    </div>
  </section>

  {% if report.clients %}
  <section>
    <h2 class="section-title">客戶成本排行 <span class="pill">{{ report.clients|length }} 個客戶</span></h2>
    <div class="card">
      <div class="bars">
        {% set top_cost = report.clients[0].cost if report.clients[0].cost > 0 else 1 %}
        {% for client in report.clients %}
        <div class="bar-row">
          <div class="name">{{ client.name }}</div>
          <div class="track"><div class="fill" style="width: {{ (client.cost / top_cost * 100)|round(2) }}%;"></div></div>
          <div class="num">
            NT$ {{ '{:,.0f}'.format(client.cost) }}
            <span class="pct">{{ '{:.1%}'.format(client.cost / report.billable_cost if report.billable_cost else 0) }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if report.clients %}
  <section>
    <h2 class="section-title">專案明細 <span class="pill">展開查看每位貢獻者</span></h2>
    {% for client in report.clients %}
    <details class="client" {% if loop.first %}open{% endif %}>
      <summary>
        <span class="cname">{{ client.name }}</span>
        <span class="csub">{{ '{:,.1f}'.format(client.hours) }}h ・ NT$ {{ '{:,.0f}'.format(client.cost) }}</span>
      </summary>
      <div class="project-list">
        {% for project in client.projects.values() %}
        <div class="project">
          <div class="project-head">
            <div class="project-name">{{ project.name }}</div>
            <div class="project-num">{{ '{:,.1f}'.format(project.hours) }}h ・ NT$ {{ '{:,.0f}'.format(project.cost) }}</div>
          </div>
          <ul class="contributors">
            {% for c in project.contributors.values()|sort(attribute='cost', reverse=true) %}
            <li class="{% if c.is_unknown %}unknown{% endif %}">
              <span>
                <span class="who">{{ c.full_name }}</span>
                <span class="dept">{{ c.department }}</span>
              </span>
              <span>{{ '{:,.1f}'.format(c.hours) }}h ・ NT$ {{ '{:,.0f}'.format(c.cost) }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  {% if report.department_costs %}
  <section>
    <h2 class="section-title">部門成本分布</h2>
    <div class="card">
      <div class="dept-grid">
        <div>
          {{ donut_svg | safe }}
        </div>
        <table class="dept-table">
          <thead><tr><th>部門</th><th class="num">工時</th><th class="num">成本</th><th class="num">占比</th></tr></thead>
          <tbody>
            {% for dept, cost in dept_sorted %}
            <tr>
              <td><span class="dept-swatch" style="background: {{ dept_colors[dept] }};"></span>{{ dept }}</td>
              <td class="num">{{ '{:,.1f}'.format(report.department_hours.get(dept, 0)) }}h</td>
              <td class="num">NT$ {{ '{:,.0f}'.format(cost) }}</td>
              <td class="num">{{ '{:.1%}'.format(cost / report.total_cost if report.total_cost else 0) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {% endif %}

  {% if report.internal_projects %}
  <section>
    <h2 class="section-title">內部投入明細 <span class="pill">酷客創藝</span></h2>
    <div class="card">
      <div class="bars">
        {% set int_top = report.internal_projects[0].cost if report.internal_projects[0].cost > 0 else 1 %}
        {% for p in report.internal_projects %}
        <div class="bar-row">
          <div class="name">{{ p.name }}</div>
          <div class="track"><div class="fill" style="width: {{ (p.cost / int_top * 100)|round(2) }}%; background: linear-gradient(90deg, #6B6960, #B0AFA6);"></div></div>
          <div class="num">
            {{ '{:,.1f}'.format(p.hours) }}h
            <span class="pct">NT$ {{ '{:,.0f}'.format(p.cost) }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if report.unclassified %}
  <section>
    <h2 class="section-title">未分類工時 <span class="pill">需 PM 補填</span></h2>
    <div class="card">
      <div class="callout">
        以下 {{ report.unclassified|length }} 筆工時缺客戶或專案名,但已計入總成本。請對應 PM 於下週補填 Google Sheet。
      </div>
      <table class="dept-table" style="margin-top: 16px;">
        <thead><tr><th>專案</th><th>客戶</th><th class="num">工時</th><th class="num">成本</th></tr></thead>
        <tbody>
          {% for p in report.unclassified %}
          <tr>
            <td>{{ p.name }}</td>
            <td>{{ p.client }}</td>
            <td class="num">{{ '{:,.1f}'.format(p.hours) }}h</td>
            <td class="num">NT$ {{ '{:,.0f}'.format(p.cost) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <section>
    <h2 class="section-title">資料品質</h2>
    <div class="card">
      <table class="dept-table">
        <tbody>
          <tr><td>原始列數</td><td class="num">{{ report.quality.rows_total }}</td></tr>
          <tr><td>計入專案的列數</td><td class="num">{{ report.quality.rows_used }}</td></tr>
          <tr><td>缺工時 (跳過)</td><td class="num">{{ report.quality.rows_missing_hours }}</td></tr>
          <tr><td>未對應姓名 (以部門均薪估算)</td><td class="num">{{ report.quality.rows_unmapped_name }}</td></tr>
          <tr><td>對應到姓名但無薪資資料</td><td class="num">{{ report.quality.rows_no_salary }}</td></tr>
        </tbody>
      </table>
      {% if report.quality.unknown_nicknames %}
      <div class="callout" style="margin-top: 12px;">
        <strong>未對應暱稱：</strong>
        {{ report.quality.unknown_nicknames|sort|join('、') }}
        — 請補進 <code>scripts/name_map.py</code>。
      </div>
      {% endif %}
    </div>
  </section>

  <footer>
    <p>
      資料來源：Notion <em>💰 人力成本分析</em> + Google Sheet <em>工作日誌2026</em>｜
      成本基準：完整勞動成本 (本俸 × 1.2551，含勞健保/勞退/年終分攤)。
    </p>
    <p>
      由 GitHub Actions 於每週一 05:00 (Asia/Taipei) 自動生成。
      Generated {{ generated_at }}
      {% if git_sha %}・ commit <code>{{ git_sha[:7] }}</code>{% endif %}
    </p>
  </footer>

</div>
</body>
</html>
